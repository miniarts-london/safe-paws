{
  "expo": {
    "name": "Egypt Animal SOS",
    "slug": "safe-paws",
    "scheme": "safepaws",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.example.safepaws",
      "supportsTablet": true
    },
    "android": {
      "package": "org.example.safepaws"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Egypt Animal SOS to use the microphone so you can speak updates instead of typing them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45076a12-6013-40ef-bd1d-88a532fcd4d8"
      }
    },
    "owner": "miniarts"
  }
}
