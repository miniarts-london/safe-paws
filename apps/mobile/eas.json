{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://safe-paws-seven.vercel.app",
        "EXPO_PUBLIC_BOARD_WS_URL": "wss://safe-pawsserver-production.up.railway.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://safe-paws-seven.vercel.app",
        "EXPO_PUBLIC_BOARD_WS_URL": "wss://safe-pawsserver-production.up.railway.app"
      }
    }
  }
}
