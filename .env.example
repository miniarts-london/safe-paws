# Copy to .env.local at the repo root. The web app, the board server and the db scripts all read it.

# Postgres. The default matches docker-compose.yml (npm run db:up).
# For a hosted database (Neon, Supabase, RDS…) paste its connection string here.
DATABASE_URL=postgres://safepaws:safepaws@localhost:5432/safepaws

# Signs session cookies. Required in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Pages allowed to open a board connection (comma-separated). Defaults to localhost:3000.
# BOARD_ALLOWED_ORIGINS=https://rescue.example.org

# Where the browser finds the board server. Defaults to ws://localhost:8788.
# NEXT_PUBLIC_BOARD_WS_URL=wss://board.rescue.example.org

# Origins allowed to call /api/auth/token from a browser: the mobile app's web preview.
# APP_WEB_ORIGINS=http://localhost:8081

# The mobile app works these out from Expo's dev server in development.
# For a real build, put these in apps/mobile/.env:
# EXPO_PUBLIC_API_URL=https://rescue.example.org
# EXPO_PUBLIC_BOARD_WS_URL=wss://board.rescue.example.org
