{
  "name": "safe-paws",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run db:setup && concurrently -k -n web,server -c blue,green \"npm run dev -w @safe-paws/web\" \"npm run dev -w @safe-paws/server\"",
    "dev:web": "npm run dev -w @safe-paws/web",
    "dev:server": "npm run dev -w @safe-paws/server",
    "dev:mobile": "npm run start -w @safe-paws/mobile",
    "build": "npm run build -w @safe-paws/web",
    "start": "npm run db:migrate && concurrently -k -n web,server \"npm run start -w @safe-paws/web\" \"npm run start -w @safe-paws/server\"",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:migrate": "npm run migrate -w @safe-paws/db",
    "db:seed": "npm run seed -w @safe-paws/db",
    "db:demo": "npm run demo -w @safe-paws/db",
    "db:reset": "npm run reset -w @safe-paws/db",
    "smoke": "npm run smoke -w @safe-paws/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
